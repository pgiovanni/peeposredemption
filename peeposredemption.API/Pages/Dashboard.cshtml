@page
@model peeposredemption.API.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["NoIndex"] = true;
}

<style>
    .dash-form { display: flex; flex-direction: column; gap: 10px; max-width: 520px; }
    .dash-form label { font-size: 12px; font-weight: 600; color: #949ba4; text-transform: uppercase; letter-spacing: .3px; }
    .dash-input { padding: 8px 10px; background: #1e1f22; border: 1px solid #3f4147; border-radius: 6px; color: #f2f3f5; font-size: 14px; width: 100%; }
    .dash-input:focus { outline: none; border-color: #00BFA5; }
    .dash-row { display: flex; gap: 10px; }
    .dash-row > div { flex: 1; }
    .dash-msg { background: rgba(0,191,165,.12); border: 1px solid #00BFA5; color: #f2f3f5; border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; font-size: 14px; }
    .dash-err { background: rgba(220,38,38,.12); border: 1px solid #dc2626; color: #f2f3f5; border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; font-size: 14px; }
    .dash-note { color: #949ba4; font-size: 13px; }
</style>

<div class="app-shell">
    <div class="sidebar">
        <div class="sidebar-header">
            <a href="/" class="icon-btn" title="Home">&#8592;</a>
            <span>Dashboard</span>
        </div>
        <div class="sidebar-section-header">YOUR ACCOUNT</div>
        <a href="/Dashboard?tab=account" class="channel-item @(Model.Tab == "account" ? "active" : "")">👤 Account</a>
        <a href="/Dashboard?tab=projects" class="channel-item @(Model.Tab == "projects" ? "active" : "")">📁 Projects</a>
        <a href="/Dashboard?tab=billing" class="channel-item @(Model.Tab == "billing" ? "active" : "")">💳 Billing</a>
        <a href="/Dashboard?tab=orders" class="channel-item @(Model.Tab == "orders" ? "active" : "")">📦 Orders</a>
        <div class="sidebar-section-header">COMMUNITY</div>
        <a href="/Dashboard?tab=community" class="channel-item @(Model.Tab == "community" ? "active" : "")">💬 Community</a>
        <a href="/App/Index" class="channel-item">🚀 Open Chat</a>
    </div>

    <div class="sidebar-backdrop"></div>

    <div class="content-area settings-page">
        <div class="content-header">
            <button class="mobile-menu-btn" aria-label="Open menu">&#9776;</button>
            <span>
                @(Model.Tab switch {
                    "projects" => "Projects",
                    "billing" => "Billing",
                    "orders" => "Orders",
                    "community" => "Community",
                    _ => "Account"
                })
            </span>
        </div>

        <div class="settings-body">
            @if (Model.Tab == "account")
            {
                @if (TempData["AccountMsg"] is string msg)
                {
                    <div class="dash-msg">@msg</div>
                }
                @if (TempData["AccountErr"] is string err)
                {
                    <div class="dash-err">@err</div>
                }

                <section class="settings-section">
                    <h3 class="settings-heading">PROFILE</h3>
                    <p class="dash-note" style="margin-bottom:14px">
                        One profile for everything — what you save here is exactly what the chat and community see.
                    </p>
                    <div class="profile-container" style="max-width:560px">
                        <!-- Live preview card (same markup/classes as the chat's editor) -->
                        <div class="profile-preview-card" style="@(Model.CurrentUser.ProfileBackgroundColor != null ? $"background-color:{Model.CurrentUser.ProfileBackgroundColor}" : "")">
                            <div class="profile-banner" id="banner-preview">
                                @if (Model.CurrentUser.BannerUrl != null)
                                {
                                    <img src="@Model.CurrentUser.BannerUrl" alt="Banner" />
                                }
                                <label class="profile-upload-overlay" for="avatarBannerFile" title="Change banner">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                    </svg>
                                </label>
                            </div>
                            <div class="profile-avatar-section">
                                <div class="profile-avatar" id="avatar-preview">
                                    @if (Model.CurrentUser.AvatarUrl != null)
                                    {
                                        <img src="@Model.CurrentUser.AvatarUrl" alt="Avatar" />
                                    }
                                    else
                                    {
                                        <span class="profile-avatar-initial">@Model.CurrentUser.Username.Substring(0, 1).ToUpper()</span>
                                    }
                                    <label class="profile-avatar-upload" for="avatarFileInput" title="Change avatar">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                        </svg>
                                    </label>
                                </div>
                                <div class="profile-preview-info">
                                    <span class="profile-preview-displayname" id="preview-displayname">@(Model.CurrentUser.DisplayName ?? Model.CurrentUser.Username)</span>
                                    <span class="profile-preview-username">@@@Model.CurrentUser.Username</span>
                                    @if (Model.CurrentUser.Pronouns != null)
                                    {
                                        <span class="profile-preview-pronouns" id="preview-pronouns">@Model.CurrentUser.Pronouns</span>
                                    }
                                </div>
                            </div>
                            @if (Model.CurrentUser.Bio != null)
                            {
                                <div class="profile-preview-bio" id="preview-bio">@Model.CurrentUser.Bio</div>
                            }
                        </div>

                        @if (Model.Badges.Any())
                        {
                            <div class="profile-section">
                                <div class="profile-section-label">BADGES</div>
                                <div class="profile-badges-grid">
                                    @foreach (var badge in Model.Badges)
                                    {
                                        <div class="profile-badge" title="@badge.Name — @badge.Description">
                                            <span class="profile-badge-icon">@badge.Icon</span>
                                            <span class="profile-badge-name">@badge.Name</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <form method="post" asp-page-handler="Profile" enctype="multipart/form-data" class="profile-form">
                            <input type="file" id="avatarFileInput" name="avatarFile" accept="image/png,image/jpeg,image/webp,image/gif" class="hidden" />
                            <input type="file" id="avatarBannerFile" name="bannerFile" accept="image/png,image/jpeg,image/webp,image/gif" class="hidden" />

                            <div class="form-group">
                                <label>Username</label>
                                <input type="text" value="@Model.CurrentUser.Username" disabled />
                                <span class="form-hint">Your unique handle used for friend requests.</span>
                            </div>

                            <div class="form-group">
                                <label>Display Name</label>
                                <input type="text" name="displayName" value="@Model.CurrentUser.DisplayName" placeholder="@Model.CurrentUser.Username" maxlength="32" id="displayNameInput" />
                                <span class="form-hint">How others see you in chat.</span>
                            </div>

                            <div class="form-group">
                                <label>Bio</label>
                                <textarea name="bio" maxlength="200" rows="3" placeholder="Tell us about yourself..." id="bioInput">@Model.CurrentUser.Bio</textarea>
                                <span class="form-hint"><span id="bio-count">@(Model.CurrentUser.Bio?.Length ?? 0)</span>/200</span>
                            </div>

                            <div class="form-group">
                                <label>Pronouns</label>
                                <input type="text" name="pronouns" value="@Model.CurrentUser.Pronouns" placeholder="e.g. he/him, she/her, they/them" maxlength="30" id="pronounsInput" />
                            </div>

                            <div class="form-group">
                                <label>Profile Background Color</label>
                                <div class="profile-color-picker">
                                    <input type="color" name="profileBackgroundColor" value="@(Model.CurrentUser.ProfileBackgroundColor ?? "#2b2d31")" id="bgColorInput" />
                                    <span class="profile-color-hex" id="bgColorHex">@(Model.CurrentUser.ProfileBackgroundColor ?? "#2b2d31")</span>
                                    <button type="button" class="btn-cancel btn-sm" id="resetColorBtn">Reset</button>
                                </div>
                            </div>

                            <div class="profile-form-actions">
                                <button type="submit" class="btn-primary">Save Changes</button>
                            </div>
                        </form>
                    </div>
                </section>

                <section class="settings-section">
                    <h3 class="settings-heading">CONTACT &amp; BILLING DETAILS</h3>
                    <p class="dash-note" style="margin-bottom:14px">Used for quotes and invoices. Only you and Torvex see this.</p>
                    <form method="post" asp-page-handler="Contact" class="dash-form">
                        <div class="dash-row">
                            <div>
                                <label>Full name</label>
                                <input class="dash-input" name="fullName" value="@Model.Contact?.FullName" />
                            </div>
                            <div>
                                <label>Company</label>
                                <input class="dash-input" name="company" value="@Model.Contact?.Company" />
                            </div>
                        </div>
                        <div>
                            <label>Phone</label>
                            <input class="dash-input" name="phone" value="@Model.Contact?.Phone" />
                        </div>
                        <div>
                            <label>Address line 1</label>
                            <input class="dash-input" name="addressLine1" value="@Model.Contact?.AddressLine1" />
                        </div>
                        <div>
                            <label>Address line 2</label>
                            <input class="dash-input" name="addressLine2" value="@Model.Contact?.AddressLine2" />
                        </div>
                        <div class="dash-row">
                            <div>
                                <label>City</label>
                                <input class="dash-input" name="city" value="@Model.Contact?.City" />
                            </div>
                            <div>
                                <label>State</label>
                                <input class="dash-input" name="state" value="@Model.Contact?.State" />
                            </div>
                        </div>
                        <div class="dash-row">
                            <div>
                                <label>Postal code</label>
                                <input class="dash-input" name="postalCode" value="@Model.Contact?.PostalCode" />
                            </div>
                            <div>
                                <label>Country</label>
                                <input class="dash-input" name="country" value="@Model.Contact?.Country" />
                            </div>
                        </div>
                        <div><button type="submit" class="btn-primary btn-sm">Save details</button></div>
                    </form>
                </section>

                <section class="settings-section">
                    <h3 class="settings-heading">EMAIL &amp; SECURITY</h3>
                    <p style="margin-bottom:4px">
                        Signed in as <strong style="color:#f2f3f5">@Model.CurrentUser.Email</strong>
                        <span class="dash-note">· member since @Model.CurrentUser.CreatedAt.ToString("MMMM yyyy")</span>
                    </p>
                    @if (!string.IsNullOrEmpty(Model.CurrentUser.PendingEmail))
                    {
                        <p class="dash-note" style="margin-bottom:10px">⏳ Change to <strong style="color:#f2f3f5">@Model.CurrentUser.PendingEmail</strong> pending — check that inbox for the verification link.</p>
                    }
                    <form method="post" asp-page-handler="Email" class="dash-form" style="margin-top:10px">
                        <div>
                            <label>Change email</label>
                            <input class="dash-input" type="email" name="newEmail" placeholder="new@email.com" />
                        </div>
                        <div><button type="submit" class="btn-primary btn-sm">Send verification</button></div>
                        <p class="dash-note">Your current email keeps working until the new one is verified.</p>
                    </form>
                    <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:18px">
                        <form method="post" asp-page-handler="Password" style="display:inline">
                            <button type="submit" class="btn-primary btn-sm">Change password</button>
                        </form>
                        <a href="/App/MfaSetup" class="btn-primary btn-sm">Two-factor auth</a>
                        <a href="/App/Sessions" class="btn-primary btn-sm">Active sessions</a>
                    </div>
                </section>
            }
            else if (Model.Tab == "projects")
            {
                <section class="settings-section">
                    <h3 class="settings-heading">ACTIVE PROJECTS</h3>
                    <div class="sidebar-empty" style="padding:24px 0">
                        No active projects yet. When an engagement starts, its progress and updates will live here.
                    </div>
                    <a href="/Packages" class="btn-primary btn-sm">Browse packages</a>
                </section>
            }
            else if (Model.Tab == "billing")
            {
                <section class="settings-section">
                    <h3 class="settings-heading">BILLING</h3>
                    <div class="sidebar-empty" style="padding:24px 0">
                        No invoices yet. Right now invoices are sent by email when an engagement starts — a full billing history will appear here soon.
                    </div>
                    <p class="dash-note" style="margin:10px 0 14px">Invoices use your <a href="/Dashboard?tab=account" style="color:#00BFA5">contact &amp; billing details</a> — keep them current.</p>
                    <a href="/Contact" class="btn-primary btn-sm">Questions about billing? Get in touch</a>
                </section>
            }
            else if (Model.Tab == "orders")
            {
                <section class="settings-section">
                    <h3 class="settings-heading">YOUR ORDERS &amp; INQUIRIES</h3>
                    @if (!Model.Orders.Any())
                    {
                        <div class="sidebar-empty" style="padding:24px 0">
                            Nothing yet. Order a package or send an inquiry and you'll see its status here.
                        </div>
                        <a href="/Packages" class="btn-primary btn-sm">Browse packages</a>
                    }
                    else
                    {
                        <div class="admin-table-wrap">
                        <table class="audit-table">
                            <thead>
                                <tr>
                                    <th>Package</th>
                                    <th>Message</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.Orders)
                                {
                                    <tr>
                                        <td><strong>@(order.Package ?? "General inquiry")</strong></td>
                                        <td style="max-width:340px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@order.Message">@order.Message</td>
                                        <td>@peeposredemption.API.Pages.DashboardModel.CustomerStatus(order.Status)</td>
                                        <td class="audit-time">@order.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                        <p class="dash-note" style="margin-top:12px">Showing inquiries submitted with @Model.CurrentUser.Email.</p>
                    }
                </section>
            }
            else if (Model.Tab == "community")
            {
                <section class="settings-section">
                    <h3 class="settings-heading">TORVEX COMMUNITY</h3>
                    <p style="color:#b5bac1;margin-bottom:16px">
                        The chat platform where Torvex started — servers, voice, the in-chat game, and the people. Free, and yours to use.
                    </p>
                    <p style="display:flex;gap:16px;flex-wrap:wrap">
                        <a href="/App/Index" class="btn-primary btn-sm">Open Torvex Chat</a>
                        <a href="https://discord.gg/scpwTFGVkz" class="btn-primary btn-sm" target="_blank" rel="noopener noreferrer">Join our Discord</a>
                        <a href="https://community.torvex.app" class="btn-primary btn-sm">About the Community</a>
                    </p>
                </section>
            }
        </div>
    </div>
</div>

@section Scripts {
@if (Model.Tab == "account")
{
<script>
    // Avatar preview
    document.getElementById('avatarFileInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        if (file.size > 15 * 1024 * 1024) { alert('Avatar must be under 15MB.'); e.target.value = ''; return; }
        const preview = document.getElementById('avatar-preview');
        const img = preview.querySelector('img') || document.createElement('img');
        img.src = URL.createObjectURL(file);
        img.alt = 'Avatar';
        const initial = preview.querySelector('.profile-avatar-initial');
        if (initial) initial.style.display = 'none';
        if (!preview.querySelector('img')) preview.insertBefore(img, preview.firstChild);
    });

    // Banner preview
    document.getElementById('avatarBannerFile').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        if (file.size > 15 * 1024 * 1024) { alert('Banner must be under 15MB.'); e.target.value = ''; return; }
        const preview = document.getElementById('banner-preview');
        const img = preview.querySelector('img') || document.createElement('img');
        img.src = URL.createObjectURL(file);
        img.alt = 'Banner';
        if (!preview.querySelector('img')) preview.insertBefore(img, preview.firstChild);
    });

    // Bio counter + live preview
    const bioInput = document.getElementById('bioInput');
    const bioCount = document.getElementById('bio-count');
    bioInput.addEventListener('input', function() {
        bioCount.textContent = this.value.length;
        let preview = document.getElementById('preview-bio');
        if (!preview) {
            preview = document.createElement('div');
            preview.className = 'profile-preview-bio';
            preview.id = 'preview-bio';
            document.querySelector('.profile-preview-card').appendChild(preview);
        }
        preview.textContent = this.value;
        preview.style.display = this.value ? '' : 'none';
    });

    // Live preview: display name
    document.getElementById('displayNameInput').addEventListener('input', function() {
        document.getElementById('preview-displayname').textContent = this.value || '@Model.CurrentUser.Username';
    });

    // Live preview: pronouns
    document.getElementById('pronounsInput').addEventListener('input', function() {
        let preview = document.getElementById('preview-pronouns');
        if (!preview) {
            preview = document.createElement('span');
            preview.className = 'profile-preview-pronouns';
            preview.id = 'preview-pronouns';
            document.querySelector('.profile-preview-info').appendChild(preview);
        }
        preview.textContent = this.value;
        preview.style.display = this.value ? '' : 'none';
    });

    // Color picker
    const bgColorInput = document.getElementById('bgColorInput');
    const bgColorHex = document.getElementById('bgColorHex');
    bgColorInput.addEventListener('input', function() {
        bgColorHex.textContent = this.value;
        document.querySelector('.profile-preview-card').style.backgroundColor = this.value;
    });
    document.getElementById('resetColorBtn').addEventListener('click', function() {
        bgColorInput.value = '#2b2d31';
        bgColorHex.textContent = '#2b2d31';
        document.querySelector('.profile-preview-card').style.backgroundColor = '';
    });
</script>
}
}
