@page
@model peeposredemption.API.Pages.ContactModel
@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Contact — Torvex IT Solutions";
    ViewData["OgTitle"] = "Contact Torvex";
    ViewData["Description"] = "Tell me about your IT problem or project. You'll hear back within one business day.";
}

<section class="hero" style="padding-bottom:24px">
    <h1>Let's <span class="hero-accent">talk.</span></h1>
    <p class="hero-emotional">Describe the problem or the project — plain English is perfect.</p>
    <div class="hero-micro">You'll hear back within one business day.</div>
</section>

<section class="contact-section">
    @if (Model.Sent)
    {
        <div class="contact-success">
            <span class="contact-success-icon">✅</span>
            <h2>Message sent.</h2>
            <p>Thanks for reaching out — you'll get a reply at the email you provided, usually within one business day.</p>
            <a href="/" class="section-link">Back to the home page &rarr;</a>
        </div>
    }
    else
    {
        <form method="post" class="contact-form">
            <div asp-validation-summary="All" class="contact-errors"></div>

            <div class="contact-field">
                <label asp-for="Name">Your name</label>
                <input asp-for="Name" placeholder="Jane Doe" />
            </div>

            <div class="contact-field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" placeholder="you@company.com" />
            </div>

            <div class="contact-field">
                <label asp-for="Company">Company <span class="contact-optional">(optional)</span></label>
                <input asp-for="Company" placeholder="Company name" />
            </div>

            <div class="contact-field">
                <label asp-for="Package">Interested in <span class="contact-optional">(optional)</span></label>
                <select asp-for="Package">
                    <option value="">Not sure yet — just describing the problem</option>
                    @foreach (var pkg in peeposredemption.API.Infrastructure.ServiceCatalog.Packages)
                    {
                        <option value="@pkg.Name">@pkg.Name (@pkg.Price)</option>
                    }
                </select>
            </div>

            <div class="contact-field">
                <label asp-for="Message">What do you need?</label>
                <textarea asp-for="Message" rows="7" placeholder="What's broken, what's slow, or what do you wish existed? A couple of sentences is plenty."></textarea>
            </div>

            <div class="cf-turnstile" data-sitekey="@ViewData["TurnstileSiteKey"]" style="margin-top:4px"></div>

            <button type="submit" class="btn-large btn-signup contact-submit">Send message</button>
            <p class="contact-privacy">Your message goes straight to admin@torvex.app — no lists, no spam.</p>
        </form>
    }
</section>

@section Scripts {
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
}
